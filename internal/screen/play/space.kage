var FloorColor vec3
var CeilingColor vec3
var Darkness float
var Textured vec3
var WallTint vec3
var FloorTint vec3
var CeilingTint vec3
var SkyTint vec3
var HasSky float
var BuildingEnabled float
var BuildingColors [33]vec4
var BuildingUV [33]vec4
var RoofAppearance [64]vec2
var Daylight float
var Time float
var LightCount float
var Lights [16]vec4
var LightColors [16]vec4
var BuildingGlow [33]float
var OpeningCount float
var OpeningPlane [32]vec4
var OpeningRect [32]vec4
var OpeningLook [32]float

// Bilinear within the material's own tile: a facade seen up close is smooth
// rather than blocky, and never bleeds into its neighbor in the atlas.
func buildingTexture(id float, uv vec2) vec3 {
 o:=imageSrc0Origin()+vec2(mod(id,8),floor(id/8))*512
 p:=clamp(clamp(uv,vec2(0),vec2(1))*512-.5,vec2(0),vec2(511))
 b:=floor(p);f:=p-b;n:=min(b+1,vec2(511))
 c00:=imageSrc1UnsafeAtFromSrc0Pos(o+b+.5).rgb
 c10:=imageSrc1UnsafeAtFromSrc0Pos(o+vec2(n.x,b.y)+.5).rgb
 c01:=imageSrc1UnsafeAtFromSrc0Pos(o+vec2(b.x,n.y)+.5).rgb
 c11:=imageSrc1UnsafeAtFromSrc0Pos(o+n+.5).rgb
 return mix(mix(c00,c10,f.x),mix(c01,c11,f.x),f.y)
}

func wallMaterial(point,face vec3) float {
 p:=floor(vec3(point.x-face.x*.001,(point.y-face.y*.001)/1.5,point.z-face.z*.001))
 if p.x<0 || p.z<0 || p.y<0 || p.x>=MapSize.x || p.z>=MapSize.y || p.y>=Levels {return 0}
 ids:=floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,640+p.y*64+p.z+.5)).rgb*255+.5)
 if face.x>0 {return ids.y};if face.z>0 {return ids.z}
 if face.x<0 {return floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,1152+p.y*64+p.z+.5)).r*255+.5)}
 return ids.x
}

// floorMaterial is the walking-surface material of a cell on a story (0: none).
func floorMaterial(p vec3) float {
 if p.x<0 || p.z<0 || p.y<0 || p.x>=MapSize.x || p.z>=MapSize.y || p.y>=Levels {return 0}
 return floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,1152+p.y*64+p.z+.5)).g*255+.5)
}

// materialUV is where a world-space surface coordinate falls in a material's
// picture, with its repetition size and origin.
func materialUV(id float, uv vec2) vec2 {
 config:=BuildingUV[int(id)]
 return fract((uv-config.zw)/config.xy)
}

// buildingNormal is a material's tangent-space normal (x right, y up the
// picture, z out of the surface), from the 256-pixel tiles under the colors.
// A material without a normal map has a flat tile.
func buildingNormal(id float, uv vec2) vec3 {
 o:=imageSrc0Origin()+vec2(mod(id,8)*256,2560+floor(id/8)*256)
 p:=clamp(uv*256-.5,vec2(0),vec2(255))
 b:=floor(p);f:=p-b;n:=min(b+1,vec2(255))
 c00:=imageSrc1UnsafeAtFromSrc0Pos(o+b+.5).rgb
 c10:=imageSrc1UnsafeAtFromSrc0Pos(o+vec2(n.x,b.y)+.5).rgb
 c01:=imageSrc1UnsafeAtFromSrc0Pos(o+vec2(b.x,n.y)+.5).rgb
 c11:=imageSrc1UnsafeAtFromSrc0Pos(o+n+.5).rgb
 return normalize(mix(mix(c00,c10,f.x),mix(c01,c11,f.x),f.y)*2-1)
}

func buildingColor(id float, uv vec2) vec3 {
 index:=int(id)
 config:=BuildingUV[index]
 color:=BuildingColors[index]
 if color.w>0 {return color.rgb*buildingTexture(id,fract((uv-config.zw)/config.xy))}
 return color.rgb
}


// Trace sunlight through the same bounded occupancy used for visible geometry.
// Horizontal slabs occlude the sky even where there is no full-height wall.
func sunlight(point, normal, shade vec3) float {
 light:=normalize(vec3(-.35,1,-.22))
 start:=point+normal*.004
 for level:=0;level<8;level++ {
  height:=float(level)*1.5
  t:=(height-start.y)/light.y
  if t>0 {
   q:=start+light*t
   c:=cell(vec3(floor(q.x),float(level),floor(q.z)))
   if c.x>0 {return 0}
  }
 }
 for i:=1;i<=8;i++ {
  q:=start+light*float(i)*.35
  if cell(floor(vec3(q.x,q.y/1.5,q.z))).x==2 {return 0}
 }
 return max(0,dot(shade,light))
}

// pointLights sums the lanterns that reach a point and see it: a few samples
// along the way stop at full-height walls, so a light does not shine through
// a wall into the next room.
func pointLights(point, normal, shade vec3) vec3 {
 sum:=vec3(0)
 start:=point+normal*.01
 for i:=0;i<16;i++ {
  if float(i)>=LightCount {break}
  l:=Lights[i]
  to:=l.xyz-start
  d:=length(to)
  if d>=l.w {continue}
  dir:=to/max(d,.0001)
  lit:=max(0,dot(shade,dir))*max(0,dot(normal,dir)+.15)
  if lit<=0 {continue}
  blocked:=false
  for j:=1;j<8;j++ {
   q:=start+to*(float(j)/8)
   // A recess starts inside its wall cell; only later cells can block.
   if floor(q.x)==floor(start.x) && floor(q.z)==floor(start.z) {continue}
   if cell(floor(vec3(q.x,q.y/1.5,q.z))).x==2 {blocked=true}
  }
  if blocked {continue}
  fall:=1-d/l.w
  c:=LightColors[i]
  flick:=1-c.w*.35*(1+sin(Time*(7.3+float(i)*1.7)+float(i)*2.1)*sin(Time*3.1+float(i)))
  sum+=c.rgb*lit*fall*fall*flick
 }
 return sum
}

// Match distant clipping to the horizon instead of drawing a dark wall
// across an outdoor view. Downward rays fade into ground, never sky.
func backdrop(ray vec3) vec3 {
 sky:=mix(vec3(.66,.78,.84),vec3(.28,.48,.66),clamp(ray.y,0,1))
 if HasSky>0 {
  u:=fract(atan2(ray.x,-ray.z)/6.2831853+.5)
  v:=clamp(1-asin(max(ray.y,0))*2/3.14159265,0,.999)
  sky=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+vec2(u*1024,512+v*512)).rgb*SkyTint
 }
 ground:=vec3(.57,.59,.56)
 // Night darkens the sky and the horizon to a deep blue.
 sky=mix(vec3(.015,.025,.06),sky,Daylight)
 ground=mix(vec3(.02,.025,.04),ground,Daylight)
 if ray.y<0 {return mix(sky,ground,clamp(-ray.y*12,0,1))}
 return sky
}

func Fragment(dst vec4, uv vec2, tint vec4) vec4 {
 ray:=viewRay(dst.xy-imageDstOrigin())
 hit,face,c:=geometry(ray)
 if hit<10000 {
   point:=Eye+ray*hit
   if dot(face,ray)>0 {face=-face}
   // A recess cut into this wall face: step in to its back or to a side. A
   // side keeps the face's material, folded around the opening's rim so the
   // bricks or plaster just outside it turn into the wall.
   om:=float(0)
   wid:=float(-1)
   fold:=vec2(0)
   if c.x==2 && OpeningCount>0 {
    for i:=0;i<32;i++ {
     if float(i)>=OpeningCount {break}
     pl:=OpeningPlane[i]
     rc:=OpeningRect[i]
     along:=point.x
     n:=face.z
     coord:=point.z
     if pl.x<.5 {along=point.z;n=face.x;coord=point.x}
     if abs(n-pl.z)>.01 || abs(coord-pl.y)>.003 || along<rc.x || along>rc.y || point.y<rc.z || point.y>rc.w {continue}
     if BuildingEnabled>0 {wid=wallMaterial(point,face)}
     inward:=-dot(ray,face)
     va:=ray.x
     if pl.x<.5 {va=ray.z}
     back:=pl.w/max(inward,.0001)
     sa:=float(10000)
     if va>.00001 {sa=(rc.y-along)/va}
     if va< -.00001 {sa=(rc.x-along)/va}
     sy:=float(10000)
     if ray.y>.00001 {sy=(rc.w-point.y)/ray.y}
     if ray.y< -.00001 {sy=(rc.z-point.y)/ray.y}
     if back<=min(sa,sy) {
      point+=ray*back;hit+=back;om=OpeningLook[i];wid=-1
     } else if sa<sy {
      edge:=rc.x
      if va>0 {edge=rc.y}
      fold=vec2(edge+sign(va)*inward*sa,-(point.y+ray.y*sa))
      point+=ray*sa;hit+=sa
      if pl.x<.5 {face=vec3(0,0,-sign(va))} else {face=vec3(-sign(va),0,0)}
     } else {
      edge:=rc.z
      if ray.y>0 {edge=rc.w}
      fold=vec2(along+va*sy,-(edge+sign(ray.y)*inward*sy))
      point+=ray*sy;hit+=sy;face=vec3(0,-sign(ray.y),0)
     }
     break
    }
   }
   col:=FloorColor
   tex:=fract(point.xz)
   // The material and coordinates that also pick the normal map, and the
   // directions its picture runs along the surface.
   mid:=float(0)
   muv:=vec2(0)
   along:=vec3(1,0,0)
   up:=vec3(0,0,-1)
   if abs(face.y)<.5 {
    up=vec3(0,1,0)
    if abs(face.x)>.5 {along=vec3(0,0,1)}
   }
   if c.x==2 {
    col=vec3(.78,.72,.60)
    tex=fract(vec2(point.x+point.z, -point.y/1.5))
    if Textured.x>0 {
     if BuildingEnabled>0 {col=buildingTexture(0,tex)*WallTint} else {col=imageSrc1UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc1Size()).rgb*WallTint}
    }
    if BuildingEnabled>0 {
     id:=wallMaterial(point,face)
     if om>0 {id=om}
     u:=point.x
     if abs(face.x)>.5 {u=point.z}
     wuv:=vec2(u,-point.y)
     if wid>=0 {id=wid;wuv=fold}
     if id>0 {col=buildingColor(id,wuv);mid=id;muv=wuv}
    }
   } else if c.x==5 {
    col=vec3(.65,.24,.13)
    ids:=RoofAppearance[int(c.y)]
    id:=ids.x
    if face.y<0 {id=ids.y;col=vec3(.45,.31,.19)}
    if id>0 {col=buildingColor(id,point.xz);mid=id;muv=point.xz}
   } else {
    if abs(face.y)<.5 {tex=fract(vec2(point.x+point.z,-point.y))}
    if Textured.y>0 {col=imageSrc2UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc2Size()).rgb*FloorTint}
    if face.y < -.5 {
     col=CeilingColor
     if Textured.z>0 {col=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*512).rgb*CeilingTint}
    }
    if BuildingEnabled>0 && face.y > -.5 {
     // The story a surface belongs to: a floor top sits on it, a stair rises
     // from it, and a slab edge hangs just below the story it carries.
     inside:=point-face*.001
     level:=floor(point.y/1.5+.5)
     if c.x==3 {level=floor(inside.y/1.5)}
     if c.x==4 {level=floor(point.y/1.5)+1}
     id:=floorMaterial(vec3(floor(inside.x),level,floor(inside.z)))
     if id>0 {
      uv:=point.xz
      if abs(face.y)<.5 {
       uv=vec2(point.x,-point.y)
       if abs(face.x)>.5 {uv.x=point.z}
      }
      col=buildingColor(id,uv)
      mid=id
      muv=uv
     }
    }
    if c.x==3 {
     // Reuse the floor stone on the treads, with darker risers.
     col*=vec3(.92,.94,.98)
     if abs(face.y)<.5 {col*=.62}
    }
   }
   shade:=face
   if mid>0 {
    // Tilt the surface's normal by its map, keeping the frame on the face.
    t:=normalize(along-face*dot(along,face))
    b:=normalize(up-face*dot(up,face)-t*dot(up,t))
    m:=buildingNormal(mid,materialUV(mid,muv))
    shade=normalize(t*m.x+b*m.y+face*m.z)
   }
   sun:=sunlight(point,face,shade)
   // Cool ambient fill keeps shaded interiors readable; warm direct light marks
   // openings. Daylight dims both toward night, leaving a faint moonlit floor.
   light:=(vec3(.68,.70,.75)+vec3(.36,.30,.20)*sun)*(.82+.18*abs(face.y))*Daylight+vec3(.07,.08,.11)*(1-Daylight)
   light+=pointLights(point,face,shade)
   if mid>0 {light+=vec3(BuildingGlow[int(mid)])}
   fog:=exp(-hit*Darkness*.11)
   return vec4(mix(backdrop(ray),col*light,fog),1)
 }
 return vec4(backdrop(ray),1)
}
