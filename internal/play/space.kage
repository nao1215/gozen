//kage:unit pixels
package main

// Kage source 1–3 samplers take source-0 coordinates and translate origins
// internally. Keep source-0 origin even when the material images are subimages.
var Eye vec3
var Facing float
var ViewSize vec2
var MapSize vec2
var Levels float
var Far float
var FloorColor vec3
var CeilingColor vec3
var Darkness float
var Textured vec3
var WallTint vec3
var FloorTint vec3
var CeilingTint vec3
var SkyTint vec3
var HasSky float

// Trace sunlight through the same bounded occupancy used for visible geometry.
// Horizontal slabs occlude the sky even where there is no full-height wall.
func sunlight(point, normal vec3) float {
 light:=normalize(vec3(-.35,1,-.22))
 start:=point+normal*.004
 for level:=0;level<8;level++ {
  height:=float(level)*1.5
  t:=(height-start.y)/light.y
  if t>0 {
   q:=start+light*t
   c:=cell(vec3(floor(q.x),float(level),floor(q.z)))
   if c.x>0 {return 0}
  }
 }
 for i:=1;i<=8;i++ {
  q:=start+light*float(i)*.35
  if cell(floor(vec3(q.x,q.y/1.5,q.z))).x==2 {return 0}
 }
 return max(0,dot(normal,light))
}

func cell(p vec3) vec3 {
 if p.x<0 || p.z<0 || p.y<0 || p.x>=MapSize.x || p.z>=MapSize.y || p.y>=Levels { return vec3(0) }
 return floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,p.z+p.y*64+.5)).rgb*255+.5)
}

// The first positive intersection with a bounded horizontal surface.
func horizontal(eye,ray vec3, h, lo,hi float) float {
 if abs(ray.y)<.00001 {return 10000}
 t:=(h-eye.y)/ray.y
 if t>=lo-.0001 && t<=hi+.0001 {return max(t,lo)}
 return 10000
}

// Match distant clipping to the horizon instead of drawing a dark wall
// across an outdoor view. Downward rays fade into ground, never sky.
func backdrop(ray vec3) vec3 {
 sky:=mix(vec3(.66,.78,.84),vec3(.28,.48,.66),clamp(ray.y,0,1))
 if HasSky>0 {
  u:=fract(atan2(ray.x,-ray.z)/6.2831853+.5)
  v:=clamp(1-asin(max(ray.y,0))*2/3.14159265,0,.999)
  sky=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+vec2(u*1024,512+v*512)).rgb*SkyTint
 }
 if ray.y<0 {return mix(sky,vec3(.57,.59,.56),clamp(-ray.y*12,0,1))}
 return sky
}

func Fragment(dst vec4, uv vec2, tint vec4) vec4 {
 pixel:=dst.xy-imageDstOrigin()
 sx:=(pixel.x-ViewSize.x*.5)/(ViewSize.y*.9)
 sy:=(pixel.y-ViewSize.y*.42)/(ViewSize.y*.9)
 ray:=normalize(vec3(sin(Facing)+sx*cos(Facing),-sy,-cos(Facing)+sx*sin(Facing)))
 p:=floor(vec3(Eye.x,Eye.y/1.5,Eye.z))
 step:=vec3(1)
 if ray.x<0 {step.x=-1};if ray.y<0 {step.y=-1};if ray.z<0 {step.z=-1}
 delta:=vec3(1/max(abs(ray.x),.00001),1.5/max(abs(ray.y),.00001),1/max(abs(ray.z),.00001))
 edge:=vec3(p.x,p.y*1.5,p.z)
 if step.x>0 {edge.x+=1};if step.y>0 {edge.y+=1.5};if step.z>0 {edge.z+=1}
 next:=abs((edge-Eye)/vec3(max(abs(ray.x),.00001),max(abs(ray.y),.00001),max(abs(ray.z),.00001)))
 lo:=float(0)
 normal:=vec3(0,1,0)
 for iter:=0;iter<96;iter++ {
  hi:=min(next.x,min(next.y,next.z))
  if p.y>=Levels && ray.y>0 {break}
  // Clip by horizontal grid depth. Looking down from an upper story must
  // still reach the floor below instead of exposing sky at the distance limit.
  limit:=Far/max(length(ray.xz),.001)
  if lo>limit {return vec4(backdrop(ray),1)}
  c:=cell(p)
  hit:=float(10000)
  face:=normal
  if c.x==2 {hit=lo}
  if c.x==1 {hit=horizontal(Eye,ray,p.y*1.5,lo,hi);face=vec3(0,1,0)}
  if c.x==3 {
   // Measure the rise from the first cell edge to the landing edge.
   // Cell-center offsets alone omit half a cell of the run's rise.
   length:=mod(c.y,16)
   direction:=floor(c.y/16)
   axis:=vec3(0,0,-1)
   if direction==1 {axis=vec3(1,0,0)};if direction==2 {axis=vec3(0,0,1)};if direction==3 {axis=vec3(-1,0,0)}
   center:=vec3(p.x+.5,0,p.z+.5)
   origin:=dot(Eye-center,axis)
   velocity:=dot(ray,axis)
   // A staircase is a solid stepped volume, not a collection of floating planes.
   // Close the side faces at the cell entry and the underside at the story base.
   entry:=Eye+ray*lo
   alongEntry:=clamp(dot(entry-center,axis),-.49999,.49999)
   tread:=floor((alongEntry+.5)*4)
   top:=p.y*1.5+max(0,c.z+(tread+1)*.25)/length*1.5
   if entry.y>=p.y*1.5 && entry.y<=top {hit=lo;face=normal}
   if ray.y>0 {
    t:=horizontal(Eye,ray,p.y*1.5,lo,hi)
    if t<hit {hit=t;face=vec3(0,-1,0)}
   }
   for j:=0;j<4;j++ {
    a:=-.5+float(j)*.25
    b:=a+.25
    height:=p.y*1.5+max(0,c.z+b+.5)/length*1.5
    t:=horizontal(Eye,ray,height,lo,hi)
    along:=origin+t*velocity
    if along>=a-.0001 && along<=b+.0001 && t<hit {hit=t;face=vec3(0,1,0)}
    if abs(velocity)>.00001 {
     t=(a-origin)/velocity
     y:=Eye.y+t*ray.y
     low:=p.y*1.5+max(0,c.z+a+.5)/length*1.5
     if t>=lo-.0001 && t<=hi+.0001 && y>=low && y<=height && t<hit {hit=max(t,lo);face=axis}
    }
   }
  }
  // Upper floors extend below their walking surface, so atrium edges and
  // overhangs expose a closed slab rather than a zero-thickness plane.
  above:=cell(p+vec3(0,1,0))
  if above.x>0 {
   underside:=(p.y+1)*1.5-.15
   entry:=Eye+ray*lo
   slabHit:=horizontal(Eye,ray,underside,lo,hi)
   slabFace:=vec3(0,-1,0)
   if entry.y>=underside {slabHit=lo;slabFace=normal}
   if slabHit<hit {hit=slabHit;face=slabFace;c=vec3(4,0,0)}
  }
  if hit<=hi+.0001 && hit<=limit {
   point:=Eye+ray*hit
   if dot(face,ray)>0 {face=-face}
   col:=FloorColor
   tex:=fract(point.xz)
   if c.x==2 {
    col=vec3(.78,.72,.60)
    tex=fract(vec2(point.x+point.z, -point.y/1.5))
    if Textured.x>0 {col=imageSrc1UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc1Size()).rgb*WallTint}
   } else {
    if abs(face.y)<.5 {tex=fract(vec2(point.x+point.z,-point.y))}
    if Textured.y>0 {col=imageSrc2UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc2Size()).rgb*FloorTint}
    if face.y < -.5 {
     col=CeilingColor
     if Textured.z>0 {col=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*512).rgb*CeilingTint}
    }
    if c.x==3 {
     // Reuse the floor stone on the treads, with darker risers.
     col*=vec3(.92,.94,.98)
     if abs(face.y)<.5 {col*=.62}
    }
   }
   sun:=sunlight(point,face)
   // Cool ambient fill keeps shaded interiors readable; warm direct light marks openings.
   light:=vec3(.68,.70,.75)+vec3(.36,.30,.20)*sun
   light*=.82+.18*abs(face.y)
   fog:=exp(-hit*Darkness*.11)
   return vec4(mix(backdrop(ray),col*light,fog),1)
  }
  if next.x<=next.y && next.x<=next.z {lo=next.x;next.x+=delta.x;p.x+=step.x;normal=vec3(-step.x,0,0)} else if next.y<=next.z {lo=next.y;next.y+=delta.y;p.y+=step.y;normal=vec3(0,-step.y,0)} else {lo=next.z;next.z+=delta.z;p.z+=step.z;normal=vec3(0,0,-step.z)}
 }
 return vec4(backdrop(ray),1)
}
