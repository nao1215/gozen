var FloorColor vec3
var CeilingColor vec3
var Darkness float
var Textured vec3
var WallTint vec3
var FloorTint vec3
var CeilingTint vec3
var SkyTint vec3
var HasSky float
var BuildingEnabled float
var BuildingColors [33]vec4
var BuildingUV [33]vec4
var RoofAppearance [64]vec2

func buildingTexture(id float, uv vec2) vec3 {
 tile:=vec2(mod(id,8),floor(id/8))*256
 return imageSrc1UnsafeAtFromSrc0Pos(imageSrc0Origin()+tile+clamp(uv,vec2(.002),vec2(.998))*256).rgb
}

func wallMaterial(point,face vec3) float {
 p:=floor(vec3(point.x-face.x*.001,(point.y-face.y*.001)/1.5,point.z-face.z*.001))
 if p.x<0 || p.z<0 || p.y<0 || p.x>=MapSize.x || p.z>=MapSize.y || p.y>=Levels {return 0}
 ids:=floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,640+p.y*64+p.z+.5)).rgb*255+.5)
 if face.x>0 {return ids.y};if face.z>0 {return ids.z}
 if face.x<0 {return floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,1152+p.y*64+p.z+.5)).r*255+.5)}
 return ids.x
}

func buildingColor(id float, uv vec2) vec3 {
 index:=int(id)
 config:=BuildingUV[index]
 color:=BuildingColors[index]
 if color.w>0 {return color.rgb*buildingTexture(id,fract((uv-config.zw)/config.xy))}
 return color.rgb
}


// Trace sunlight through the same bounded occupancy used for visible geometry.
// Horizontal slabs occlude the sky even where there is no full-height wall.
func sunlight(point, normal vec3) float {
 light:=normalize(vec3(-.35,1,-.22))
 start:=point+normal*.004
 for level:=0;level<8;level++ {
  height:=float(level)*1.5
  t:=(height-start.y)/light.y
  if t>0 {
   q:=start+light*t
   c:=cell(vec3(floor(q.x),float(level),floor(q.z)))
   if c.x>0 {return 0}
  }
 }
 for i:=1;i<=8;i++ {
  q:=start+light*float(i)*.35
  if cell(floor(vec3(q.x,q.y/1.5,q.z))).x==2 {return 0}
 }
 return max(0,dot(normal,light))
}

// Match distant clipping to the horizon instead of drawing a dark wall
// across an outdoor view. Downward rays fade into ground, never sky.
func backdrop(ray vec3) vec3 {
 sky:=mix(vec3(.66,.78,.84),vec3(.28,.48,.66),clamp(ray.y,0,1))
 if HasSky>0 {
  u:=fract(atan2(ray.x,-ray.z)/6.2831853+.5)
  v:=clamp(1-asin(max(ray.y,0))*2/3.14159265,0,.999)
  sky=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+vec2(u*1024,512+v*512)).rgb*SkyTint
 }
 if ray.y<0 {return mix(sky,vec3(.57,.59,.56),clamp(-ray.y*12,0,1))}
 return sky
}

func Fragment(dst vec4, uv vec2, tint vec4) vec4 {
 ray:=viewRay(dst.xy-imageDstOrigin())
 hit,face,c:=geometry(ray)
 if hit<10000 {
   point:=Eye+ray*hit
   if dot(face,ray)>0 {face=-face}
   col:=FloorColor
   tex:=fract(point.xz)
   if c.x==2 {
    col=vec3(.78,.72,.60)
    tex=fract(vec2(point.x+point.z, -point.y/1.5))
    if Textured.x>0 {
     if BuildingEnabled>0 {col=buildingTexture(0,tex)*WallTint} else {col=imageSrc1UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc1Size()).rgb*WallTint}
    }
    if BuildingEnabled>0 {
     id:=wallMaterial(point,face)
     u:=point.x
     if abs(face.x)>.5 {u=point.z}
     if id>0 {col=buildingColor(id,vec2(u,-point.y))}
    }
   } else if c.x==5 {
    col=vec3(.65,.24,.13)
    ids:=RoofAppearance[int(c.y)]
    id:=ids.x
    if face.y<0 {id=ids.y;col=vec3(.45,.31,.19)}
    if id>0 {col=buildingColor(id,point.xz)}
   } else {
    if abs(face.y)<.5 {tex=fract(vec2(point.x+point.z,-point.y))}
    if Textured.y>0 {col=imageSrc2UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*imageSrc2Size()).rgb*FloorTint}
    if face.y < -.5 {
     col=CeilingColor
     if Textured.z>0 {col=imageSrc3UnsafeAtFromSrc0Pos(imageSrc0Origin()+tex*512).rgb*CeilingTint}
    }
    if c.x==3 {
     // Reuse the floor stone on the treads, with darker risers.
     col*=vec3(.92,.94,.98)
     if abs(face.y)<.5 {col*=.62}
    }
   }
   sun:=sunlight(point,face)
   // Cool ambient fill keeps shaded interiors readable; warm direct light marks openings.
   light:=vec3(.68,.70,.75)+vec3(.36,.30,.20)*sun
   light*=.82+.18*abs(face.y)
   fog:=exp(-hit*Darkness*.11)
   return vec4(mix(backdrop(ray),col*light,fog),1)
 }
 return vec4(backdrop(ray),1)
}
