//kage:unit pixels
package main

var Eye vec3
var Facing float
var ViewSize vec2
var MapSize vec2
var Levels float
var Far float
var RoofCount float
var GeometryTop float
var RoofBounds [64]vec4
var RoofPlanes [64]vec4
var RoofBottom [64]vec2

func roofClip(value, velocity, lower, upper, lo, hi float, lowNormal, highNormal, face vec3) (float,float,vec3,bool) {
 if abs(velocity)<.000001 {return lo,hi,face,value>=lower && value<=upper}
 a:=(lower-value)/velocity
 b:=(upper-value)/velocity
 n:=lowNormal
 if a>b {a,b=b,a;n=highNormal}
 if a>lo {lo=a;face=n}
 hi=min(hi,b)
 return lo,hi,face,lo<=hi+.000001
}

// The spatial index includes the full overhang, independent of the anchor.
// Clip closed inclined slabs only from this cell's (at most four) candidates.
func roofGeometry(p, ray vec3, start, end float) (float,vec3,float) {
 best:=float(10000)
 face:=vec3(0)
 part:=float(0)
 if RoofCount==0 || p.x<0 || p.z<0 || p.x>=MapSize.x || p.z>=MapSize.y {return best,face,part}
 ids:=floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,512+p.z+.5)).rgb*255+.5)
 fourth:=floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,576+p.z+.5)).r*255+.5)
 for slot:=0;slot<4;slot++ {
  id:=ids.x
  if slot==1 {id=ids.y};if slot==2 {id=ids.z};if slot==3 {id=fourth}
  if id<=0 {continue}
  index:=int(id-1)
  bounds:=RoofBounds[index]
  plane:=RoofPlanes[index]
  lo,hi:=start,end
  normal:=vec3(0,1,0)
  ok:=false
  lo,hi,normal,ok=roofClip(Eye.x,ray.x,bounds.x,bounds.z,lo,hi,vec3(-1,0,0),vec3(1,0,0),normal)
  if !ok {continue}
  lo,hi,normal,ok=roofClip(Eye.z,ray.z,bounds.y,bounds.w,lo,hi,vec3(0,0,-1),vec3(0,0,1),normal)
  if !ok {continue}
  n:=normalize(vec3(-plane.x,1,-plane.y))
  lower:=-plane.w
  bottom:=RoofBottom[index]
  if bottom.x>0 {lower=-10000}
  lo,hi,normal,ok=roofClip(Eye.y-dot(plane.xy,Eye.xz)-plane.z,ray.y-dot(plane.xy,ray.xz),lower,0,lo,hi,-n,n,normal)
  if !ok {continue}
  if bottom.x>0 {lo,hi,normal,ok=roofClip(Eye.y,ray.y,bottom.y,10000,lo,hi,vec3(0,-1,0),vec3(0,1,0),normal)}
  if ok && lo<best {best=lo;face=normal;part=float(index)}
 }
 return best,face,part
}

func cell(p vec3) vec3 {
 if p.x<0 || p.z<0 || p.y<0 || p.x>=MapSize.x || p.z>=MapSize.y || p.y>=Levels { return vec3(0) }
 return floor(imageSrc0UnsafeAt(imageSrc0Origin()+vec2(p.x+.5,p.z+p.y*64+.5)).rgb*255+.5)
}

// The first positive intersection with a bounded horizontal surface.
func horizontal(eye,ray vec3, h, lo,hi float) float {
 if abs(ray.y)<.00001 {return 10000}
 t:=(h-eye.y)/ray.y
 if t>=lo-.0001 && t<=hi+.0001 {return max(t,lo)}
 return 10000
}

func viewRay(pixel vec2) vec3 {
 sx:=(pixel.x-ViewSize.x*.5)/(ViewSize.y*.9)
 sy:=(pixel.y-ViewSize.y*.42)/(ViewSize.y*.9)
 return normalize(vec3(sin(Facing)+sx*cos(Facing),-sy,-cos(Facing)+sx*sin(Facing)))
}

// geometry is shared by terrain and sprite passes, including slab edges,
// stair risers and undersides. Distance is along the normalized view ray.
func geometry(ray vec3) (float, vec3, vec3) {
 p:=floor(vec3(Eye.x,Eye.y/1.5,Eye.z))
 step:=vec3(1)
 if ray.x<0 {step.x=-1};if ray.y<0 {step.y=-1};if ray.z<0 {step.z=-1}
 delta:=vec3(1/max(abs(ray.x),.00001),1.5/max(abs(ray.y),.00001),1/max(abs(ray.z),.00001))
 edge:=vec3(p.x,p.y*1.5,p.z)
 if step.x>0 {edge.x+=1};if step.y>0 {edge.y+=1.5};if step.z>0 {edge.z+=1}
 next:=abs((edge-Eye)/vec3(max(abs(ray.x),.00001),max(abs(ray.y),.00001),max(abs(ray.z),.00001)))
 lo:=float(0)
 normal:=vec3(0,1,0)
 for iter:=0;iter<96;iter++ {
  hi:=min(next.x,min(next.y,next.z))
  top:=Levels
  if RoofCount>0 {top=max(top,GeometryTop)}
  if p.y>=top && ray.y>0 {break}
  // Clip by horizontal grid depth. Looking down from an upper story must
  // still reach the floor below instead of exposing sky at the distance limit.
  limit:=Far/max(length(ray.xz),.001)
  if lo>limit {return 10000, vec3(0), vec3(0)}
  c:=cell(p)
  hit:=float(10000)
  face:=normal
  if c.x==2 {hit=lo}
  if c.x==1 {hit=horizontal(Eye,ray,p.y*1.5,lo,hi);face=vec3(0,1,0)}
  if c.x==3 {
   // Measure the rise from the first cell edge to the landing edge.
   // Cell-center offsets alone omit half a cell of the run's rise.
   length:=mod(c.y,16)
   direction:=floor(c.y/16)
   axis:=vec3(0,0,-1)
   if direction==1 {axis=vec3(1,0,0)};if direction==2 {axis=vec3(0,0,1)};if direction==3 {axis=vec3(-1,0,0)}
   center:=vec3(p.x+.5,0,p.z+.5)
   origin:=dot(Eye-center,axis)
   velocity:=dot(ray,axis)
   // A staircase is a solid stepped volume, not a collection of floating planes.
   // Close the side faces at the cell entry and the underside at the story base.
   entry:=Eye+ray*lo
   alongEntry:=clamp(dot(entry-center,axis),-.49999,.49999)
   tread:=floor((alongEntry+.5)*4)
   top:=p.y*1.5+max(0,c.z+(tread+1)*.25)/length*1.5
   if entry.y>=p.y*1.5 && entry.y<=top {hit=lo;face=normal}
   if ray.y>0 {
    t:=horizontal(Eye,ray,p.y*1.5,lo,hi)
    if t<hit {hit=t;face=vec3(0,-1,0)}
   }
   for j:=0;j<4;j++ {
    a:=-.5+float(j)*.25
    b:=a+.25
    height:=p.y*1.5+max(0,c.z+b+.5)/length*1.5
    t:=horizontal(Eye,ray,height,lo,hi)
    along:=origin+t*velocity
    if along>=a-.0001 && along<=b+.0001 && t<hit {hit=t;face=vec3(0,1,0)}
    if abs(velocity)>.00001 {
     t=(a-origin)/velocity
     y:=Eye.y+t*ray.y
     low:=p.y*1.5+max(0,c.z+a+.5)/length*1.5
     if t>=lo-.0001 && t<=hi+.0001 && y>=low && y<=height && t<hit {hit=max(t,lo);face=axis}
    }
   }
  }
  // Upper floors extend below their walking surface, so atrium edges and
  // overhangs expose a closed slab rather than a zero-thickness plane.
  above:=cell(p+vec3(0,1,0))
  if above.x>0 {
   underside:=(p.y+1)*1.5-.15
   entry:=Eye+ray*lo
   slabHit:=horizontal(Eye,ray,underside,lo,hi)
   slabFace:=vec3(0,-1,0)
   if entry.y>=underside {slabHit=lo;slabFace=normal}
   if slabHit<hit {hit=slabHit;face=slabFace;c=vec3(4,0,0)}
  }
  roofHit,roofFace,roofPart:=roofGeometry(p,ray,lo,hi)
  if roofHit<hit {hit=roofHit;face=roofFace;c=vec3(5,roofPart,0)}
  if hit<=hi+.0001 && hit<=limit {
   return hit, face, c
  }
  if next.x<=next.y && next.x<=next.z {lo=next.x;next.x+=delta.x;p.x+=step.x;normal=vec3(-step.x,0,0)} else if next.y<=next.z {lo=next.y;next.y+=delta.y;p.y+=step.y;normal=vec3(0,-step.y,0)} else {lo=next.z;next.z+=delta.z;p.z+=step.z;normal=vec3(0,0,-step.z)}
 }
 return 10000, vec3(0), vec3(0)
}
