# Local build, test, and tool output. Source fixtures and golden files stay tracked.
/bin/
/build/
/dist/
/.cache/
/coverage/
*.exe
*.exe~
*.dll
*.so
*.dylib

*.test
*.coverprofile
coverage.out
profile.cov

# Hugo build output and cache for the documentation website (built by
