/website/public/
/website/resources/
/website/.hugo_build.lock

# Local workspaces and environment files.
go.work
go.work.sum
.env
.env.*
!.env.example

# Editor and operating-system files.
.idea/
.vscode/
.DS_Store
Thumbs.db
